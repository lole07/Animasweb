 if(p<.15)return r<.27?'log':r<.47?'rocks':r<.62?'pillar':r<.78?'branch':r<.9?'bush':'foliage';
 if(p<.45)return r<.2?'log':r<.36?'rocks':r<.49?'pillar':r<.67?'branch':r<.84?'bush':'foliage';
 return r<.18?'log':r<.32?'rocks':r<.44?'pillar':r<.64?'branch':r<.82?'bush':'foliage';
