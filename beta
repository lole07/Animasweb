function cyl(mat,r,len,x,y,z,rz,ry){const m=new THREE.Mesh(gCyl,mat);m.scale.set(r,len,r);m.position.set(x,y,z);m.rotation.z=rz||0;m.rotation.y=ry||0;return m}
function newGroup(z){const g=new THREE.Group();g.position.set(0,0,z);g.userData.keepInRiver=1;return g}

function mkLog(z,gx,gap){
 const cx=roadX(z),g=newGroup(z),segs=[];
 for(const [a,b] of [[-13,gx-gap/2],[gx+gap/2,13]]){if(b-a<1.2)continue;
  const mid=(a+b)/2,len=b-a;g.add(cyl(wood,.75,len,cx+mid,WY+.5,0,Math.PI/2,(Math.random()-.5)*.14));
  // anillos de corteza, nudos y vetas legibles a corta distancia
  for(let q=0;q<Math.max(2,Math.floor(len/2.1));q++){const xx=a+.55+q*((len-1.1)/Math.max(1,Math.floor(len/2.1)-1));g.add(cyl(woodDark,.785,.095,cx+xx,WY+.5,.015,Math.PI/2,0));}
  for(let q=0;q<2;q++){const xx=a+.35+Math.random()*Math.max(.3,len-.7),k=new THREE.Mesh(gKnot,q?woodDark:woodLight);k.scale.set(.18,.10,.08);k.position.set(cx+xx,WY+.83,.05);g.add(k)}
  for(let q=0;q<3;q++){const moss=new THREE.Mesh(gRock,q===0?leafHi:leafM);moss.scale.set(.25+Math.random()*.22,.08,.18);moss.position.set(cx+a+.5+Math.random()*Math.max(.4,len-1),WY+1.22,.05+(Math.random()-.5)*.22);g.add(moss)}
  // extremos astillados y dos ramitas cortas
  for(const xx of [a+.08,b-.08]){const end=new THREE.Mesh(gRock,woodLight);end.scale.set(.12,.52,.52);end.position.set(cx+xx,WY+.5,0);g.add(end)}
  if(len>4){for(let q=0;q<2;q++){const twig=cyl(barkM,.10,.65,cx+a+len*(.35+q*.3),WY+.88,(q?-.24:.24),q?.65:-.72,0);g.add(twig)}}
  segs.push([a,b])}
 return{type:'log',z,cx,g,segs};
}
function mkRocks(z,gx,gap){
 const cx=roadX(z),g=newGroup(z),circles=[],lim=13;
 for(const side of [-1,1]){
  let x=(side<0?gx-gap/2:gx+gap/2)+side*1.6;
  while(side<0?x>-lim:x<lim){
   const r=1.5+Math.random()*.7,m=new THREE.Mesh(gRock,rockM);
   m.scale.set(r*1.2,r*1.5,r*1.1);m.position.set(cx+x,WY+r*.7,(Math.random()-.5)*1.2);m.rotation.y=Math.random()*6;g.add(m);
   for(let q=0;q<3;q++){const patch=new THREE.Mesh(gRock,q===0?leafHi:q===1?leafM:rockDark);patch.scale.set(r*(.25+Math.random()*.18),.09+Math.random()*.07,r*.22);patch.position.set(cx+x+(Math.random()-.5)*r,WY+r*1.65,(Math.random()-.5)*r*.7);patch.rotation.y=Math.random()*6;g.add(patch)}
   for(let q=0;q<2;q++){const chip=new THREE.Mesh(gRock,rockDark);chip.scale.set(.11,.18,.22);chip.position.set(cx+x+(Math.random()-.5)*r*1.1,WY+r*.8,(Math.random()-.5)*r);g.add(chip)}
   circles.push({x,r:r*1.15});x+=side*(r*1.6+.3);
  }
 }
 return{type:'rocks',z,cx,g,circles};
}
function mkPillars(z,gx,gap){
 const cx=roadX(z),g=newGroup(z),circles=[],lim=13;
 for(const side of [-1,1]){
  let x=(side<0?gx-gap/2:gx+gap/2)+side*1.4;
