 // estrellas
 const N=520,pos=new Float32Array(N*3),col=new Float32Array(N*3);let sd=218;
 const rn=()=>{sd=(sd*16807)%2147483647;return sd/2147483647};
 for(let i=0;i<N;i++){
  const az=rn()*Math.PI*2,el=(.1+rn()*1.3),r=380;
  pos[i*3]=Math.cos(az)*Math.cos(el)*r;pos[i*3+1]=Math.sin(el)*r;pos[i*3+2]=Math.sin(az)*Math.cos(el)*r;
