          p.ff.forEach((f,i)=>{f.position.y=.65+(i%3)*.16;f.scale.setScalar(.45)});
        }
      };
      // La escuela ya no requiere estar dentro de un arbusto: la hierba alta sirve de escondite.
      const oldHide=geHideAt;
