   const r=.65+Math.random()*.25,len=5+Math.random()*3;
   g.add(cyl(pillarM,r,len,cx+x,WY+len/2-.4,(Math.random()-.5)*1.2,(Math.random()-.5)*.1,0));
   circles.push({x,r:r+.2});x+=side*(r*2+1.1);
  }
 }
 return{type:'pillar',z,cx,g,circles};
}
function mkBranch(z,gx=0,gap=6.8){
 const cx=roadX(z),g=newGroup(z),circles=[];
 // Ramas colgantes laterales; deja un hueco central claro para reaccionar.
 for(const side of [-1,1]){
  const x=gx+side*(gap/2+1.5),len=5+Math.random()*3;
  g.add(cyl(barkM,.3,len,cx+x,WY+2.6,0,Math.PI/2,side*.08));
