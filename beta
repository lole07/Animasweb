  }
  circles.push({x,r:1.05});
 }
 return{type:'branch',z,cx,g,circles};
}
function mkBush(z,gx,gap,type='bush'){
 const cx=roadX(z),g=newGroup(z),circles=[];
 for(const side of [-1,1]){
  const x=(side<0?gx-gap/2:gx+gap/2)+side*(1.1+Math.random()*.5);
  const n=4+Math.floor(Math.random()*3);
  for(let i=0;i<n;i++){
   const r=.45+Math.random()*.55,leaf=new THREE.Mesh(gRock,i%3===0?leafHi:leafM);
   leaf.scale.set(r*1.25,r*.8,r);leaf.position.set(cx+x+(Math.random()-.5)*1.8,WY+r*.45,(Math.random()-.5)*1.5);leaf.rotation.y=Math.random()*6;g.add(leaf);
   const blade=new THREE.Mesh(gLeaf,i%3===0?leafWet:(i%2?leafHi:leafM));blade.scale.set(.22+r*.2,.62+r*.35,.16+r*.12);blade.position.set(cx+x+(Math.random()-.5)*1.6,WY+.35+Math.random()*r,(Math.random()-.5)*1.3);blade.rotation.z=(Math.random()-.5)*1.5;blade.rotation.x=(Math.random()-.5)*.8;blade.rotation.y=Math.random()*6;g.add(blade);
  }
