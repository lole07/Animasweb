<script id="v215-mohan-swim-motion">
(function(){
'use strict';
// v215: movimiento de NADO en el río del Mohán.
// Antes: el lateral se sentía como caminar (arranque instantáneo, frenado en seco, animación de caminata).
// Ahora: impulso con brazadas, inercia (planeas al soltar), poca fricción, giro suave del cuerpo hacia donde nadas,
// cuerpo inclinado hacia delante, sin animación de piernas ni de caminata.
const R=window.RIVER_CHAPTER;
if(!R||typeof update!=='function'||typeof sceneAnim!=='function'||typeof THREE==='undefined')return;
// Ajustes rápidos (se pueden tocar desde la consola: SWIM.vmax=5 ...)
const SWIM=window.SWIM=Object.assign({
 vmax:7.8,    // velocidad lateral máxima (m/s), aumentada para esquivar con más rapidez
 accel:6.2,   // aceleración de brazada más rápida
 turn:8.0,    // cambio de dirección mucho más ágil
 drag:.85,    // fricción del agua al soltar (menor = planeas más lejos)
 pulse:.12,   // cuánto empuja cada brazada (0 = velocidad uniforme)
 stroke:.95,  // brazadas por segundo
 arms:true    // brazos nadando (false = brazos quietos)
},window.SWIM||{});
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const active=()=>!!(R.active&&S==='play'&&!BS.on);
let phase=0,effort=0,yawS=0,rollS=0,leanS=0,bobS=0;

// ---- brazos: rotaciones en el espacio del personaje (no dependen de los ejes internos del esqueleto) ----
const qa=new THREE.Quaternion(),qd=new THREE.Quaternion(),qp=new THREE.Quaternion(),qr=new THREE.Quaternion(),vv=new THREE.Vector3();
const applied=new Map();
let bones=null;
function getBones(){
 if(bones)return bones;
 try{
  const ix=window.PDATA&&PDATA.ix;if(!ix)return null;
  const g=n=>pl.getObjectByName('b'+n);
  const b={sh:[g(ix.LeftArm),g(ix.RightArm)],fa:[g(ix.LeftForeArm),g(ix.RightForeArm)]};
  if(!b.sh[0]||!b.sh[1]||!b.fa[0]||!b.fa[1])return null;
  bones=b;
 }catch(e){bones=null}
 return bones;
}
function undoArms(){
 if(!applied.size)return;
 applied.forEach((dq,b)=>{b.quaternion.premultiply(qa.copy(dq).conjugate())});
 applied.clear();
}
// gira "bone" alrededor de un eje dado en el espacio del personaje (x lateral, y arriba, z atrás→adelante = -z)
function swing(bone,ax,ay,az,ang){
 if(!bone||!bone.parent||!ang)return;
 bone.parent.getWorldQuaternion(qp);pl.getWorldQuaternion(qr);
 vv.set(ax,ay,az).applyQuaternion(qr).applyQuaternion(qp.conjugate());
 qd.setFromAxisAngle(vv,ang);
 bone.quaternion.premultiply(qd);
 const prev=applied.get(bone);applied.set(bone,prev?qd.clone().multiply(prev):qd.clone());
 bone.updateMatrixWorld(true);
}

// ---- física lateral de nado ----
const u0=update;
update=function(dt,t){
 undoArms(); // deshace la pose de brazos del frame anterior antes de que corra la animación base
 if(!active())return u0.apply(this,arguments);
 const d=Math.min(.05,Math.max(0,Number(dt)||0));
 // 1) entrada lateral (A/D, flechas o joystick)
 let ix=(k.KeyD||k.ArrowRight?1:0)-(k.KeyA||k.ArrowLeft?1:0)+(JS.x||0);
 ix=clamp(ix,-1,1);if(Math.abs(ix)<.12)ix=0;
 // 2) empuje con brazadas, inercia y poca fricción
 let vx=P.vx||0;
 effort+=((ix!==0?1:0)-effort)*Math.min(1,(ix!==0?5:2.2)*d);
 phase+=d*Math.PI*2*SWIM.stroke*(.35+.65*effort);
 const pulse=1+SWIM.pulse*Math.sin(phase*2-.6)*effort;
 const target=ix*SWIM.vmax*pulse;
 const rate=ix===0?SWIM.drag:(ix*vx<-.3?SWIM.turn:SWIM.accel);
 vx+=(target-vx)*(1-Math.exp(-rate*d));
 if(ix===0&&Math.abs(vx)<.02)vx=0;
 P.vx=vx;
 // 3) la física base ve "sin entrada" y sin fricción propia: no camina, solo integra P.x con nuestra velocidad
 const sv={a:k.KeyA,d:k.KeyD,l:k.ArrowLeft,r:k.ArrowRight,jx:JS.x,ac:GX.ac,dc:GX.dc,aa:GX.acA};
 k.KeyA=k.KeyD=k.ArrowLeft=k.ArrowRight=false;JS.x=0;GX.ac=0;GX.dc=0;GX.acA=0;
 let r;
 try{r=u0.apply(this,arguments)}
 finally{k.KeyA=sv.a;k.KeyD=sv.d;k.ArrowLeft=sv.l;k.ArrowRight=sv.r;JS.x=sv.jx;GX.ac=sv.ac;GX.dc=sv.dc;GX.acA=sv.aa}
 P.yaw=0;
 return r;
};

// ---- pose de nado (se aplica al final del frame, después de la animación base) ----
const prev=sceneAnim;
sceneAnim=function(t,dt){
 const r=prev.apply(this,arguments);
 if(!active()){undoArms();return r}
 try{
  const d=Math.min(.05,Math.max(0,Number(dt)||0)),vx=P.vx||0,sf=clamp(Math.abs(vx)/SWIM.vmax,0,1);
  const k1=Math.min(1,7*d);
  // gira el cuerpo hacia donde nada, se ladea con la brazada y se inclina hacia delante
  yawS+=(-clamp(vx*.085,-.34,.34)-yawS)*k1;
  rollS+=((-vx*.045)+Math.sin(phase)*.07*(.25+sf)*effort-rollS)*k1;
  leanS+=(-(.16+.30*sf)-leanS)*Math.min(1,4*d);
  bobS+=(Math.sin(t*1.7)*.03+Math.sin(phase*2)*.035*effort-bobS)*k1;
  pl.rotation.y=yawS;pl.rotation.z=rollS;pl.rotation.x=0;
  pl.position.y=-.22+bobS-.05*sf;
  const W=PA&&PA.mx&&PA.mx.getRoot();if(W)W.rotation.x=leanS;
  const B=SWIM.arms&&effort>.03?getBones():null;
  if(B){
   pl.updateMatrixWorld(true);
   for(let i=0;i<2;i++){
    const side=i?1:-1,ph=phase+(i?Math.PI:0),amt=(.3+.7*effort)*(i?.6:1); // el brazo derecho lleva la lámpara: se mueve menos
    const s=Math.sin(ph),c=Math.cos(ph);
    // brazo: baja junto al cuerpo → sube por delante (recobro) → vuelve a bajar tirando del agua
    swing(B.sh[i],1,0,0,(1.35+1.25*s)*amt);
    swing(B.sh[i],0,0,-1,side*(.12+.16*Math.max(0,c))*amt);
    // codo: se dobla en el recobro
    swing(B.fa[i],1,0,0,(.2+.9*Math.max(0,c))*amt);
   }
  }else undoArms();
 }catch(e){console.warn('v215 nado',e)}
 return r;
};
})();
</script>

