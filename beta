<script id="v217-mohan-only-river">
(function(){
'use strict';
// v217: en el río solo existen: el agua y sus orillas, el personaje, la neblina/cielo, los efectos de velocidad y el Mohán.
// Todo lo demás que esté en la escena (árboles, follaje, espigas/hierba, arbustos, lianas, terreno de la montaña...)
// se oculta mientras el río está activo y se restaura al salir.
const R=window.RIVER_CHAPTER;
if(!R||typeof sceneAnim!=='function'||typeof scene==='undefined')return;
const hidden=new Map();let frame=0,setSize=-1,rset=new Set();
const flagged=o=>{const u=o.userData;return !!(u&&(u.rv||u.speedFx||u.mohanArena||u.mohanOnlySky||u.mohanProceduralMotion||u.mohanLoopFoam||u.mohanFoamBar||u.keepInRiver))};
function keep(o){
 if(o===pl||o===cam||(typeof GM!=='undefined'&&o===GM)||o===window.__MOHAN_RIVER_GROUP||o===R.boss)return true;
 if(o.isLight||o.isCamera||flagged(o)||rset.has(o))return true;
 try{if(BS.B&&o===BS.B.g)return true}catch(e){}
 return false;
}
function restore(){hidden.forEach((v,o)=>{o.visible=v});hidden.clear()}
const prev=sceneAnim;
sceneAnim=function(t,dt){
 const r=prev.apply(this,arguments);
 try{
  if(!R.active){if(hidden.size)restore();return r}
  if(R.objects&&R.objects.length!==setSize){setSize=R.objects.length;rset=new Set(R.objects)}
  const playing=S==='play'&&!BS.on;
  if(playing&&(frame++%8===0||hidden.size===0)){
   const ch=scene.children;
   for(let i=0;i<ch.length;i++){const o=ch[i];if(hidden.has(o)||keep(o))continue;hidden.set(o,o.visible);o.visible=false}
  }
  // otros sistemas (hierba, zonas, terreno) reactivan sus objetos cada frame: se vuelven a ocultar
  hidden.forEach((v,o)=>{if(o.visible)o.visible=false;if(!o.parent)hidden.delete(o)});
 }catch(e){console.warn('v217 solo río',e)}
 return r;
};
})();
</script>

<script id="v218-mohan-sky">
(function(){
