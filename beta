const touch=()=>typeof TOUCH!=='undefined'&&!!TOUCH;

// ---------- materiales y piezas ----------
const mat=(c,e)=>new THREE.MeshStandardMaterial({color:c,roughness:.9,emissive:e,fog:false});
const wood=mat(0x8a6038,0x3a2412),woodLight=mat(0xb18a54,0x39220d),woodDark=mat(0x38271b,0x160d08),rockM=mat(0x9aa39d,0x222a26),rockDark=mat(0x46534d,0x101a16),barkM=mat(0x6b5236,0x2a1d10),vineM=mat(0x5fa062,0x14301a),pillarM=mat(0x7d6a50,0x2d2214),leafM=mat(0x315b3b,0x102414),leafHi=mat(0x52764a,0x172b13),leafWet=mat(0x719052,0x1d3214);
rockM.flatShading=false;
