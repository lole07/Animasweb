  else if(/^El Mohán golpea el agua/.test(t))n='El Mohán golpea el agua… ¡Sumérgete ('+(tc?'Bucear':'C')+') o nada lejos!';
  if(n){const a=Array.prototype.slice.call(arguments);a[0]=n;return msg0.apply(this,a)}
 }
 return msg0.apply(this,arguments);
};

// ---------- estado ----------
function resetState(){
 SD.dash=0;SD.cd=0;SD.depth=0;SD.diving=false;SD.air=1;SD.exh=false;SD.tC=false;SD.hint=0;
 if(window.SWIM){if(SD.baseV!=null)SWIM.vmax=SD.baseV;if(SD.baseStroke!=null)SWIM.stroke=SD.baseStroke}
 if(SD.hid){try{pl.visible=true}catch(e){}SD.hid=false}
 if(wake)wake.visible=false;if(shadow)shadow.visible=false;if(flood)flood.visible=false;
 parts.forEach(p=>{p.life=0;p.m.visible=false});rings.forEach(r=>{r.t=0;r.m.visible=false});
}
if(typeof reset==='function'){const reset0=reset;reset=function(){const r=reset0.apply(this,arguments);try{resetState();if(R.active)setTimeout(()=>{if(R.active&&S==='play'&&!BS.on)msg('LA CORRIENTE TE ARRASTRA · Brazada rápida y buceo disponibles.',4200)},5200)}catch(e){}return r};}

// ---------- física: lectura de entrada y brazada ----------
const upd0=update;
update=function(dt,t){
 if(!inRiver()){return upd0.apply(this,arguments)}
 const d=Math.min(.05,Math.max(0,Number(dt)||0));
 if(window.SWIM&&SD.baseV==null){SD.baseV=SWIM.vmax;SD.baseStroke=SWIM.stroke}
 // 1) entrada de buceo (se lee antes de que otras capas limpien k.KeyC) y se anula el "agacharse" del juego base
 const want=!!(SD.kC||SD.tC||k.KeyC||(typeof GX!=='undefined'&&GX.padC));
 k.KeyC=false;try{GX.padC=0;GX.slide=0}catch(e){}
 SD.cd=Math.max(0,SD.cd-d);
 if(want&&!SD.exh&&SD.air>0){
  if(!SD.diving){SD.diving=true;build();ringAt(P.x,P.z,.9);splash(10,0,0,.8);try{if(A)thump(300,.35,.25)}catch(e){}}
 }else if(SD.diving){SD.diving=false;build();ringAt(P.x,P.z,.9);splash(8,0,0,.7)}
 if(SD.diving){
  SD.air=Math.max(0,SD.air-d/CFG.airSeconds);
  if(SD.air<=0){SD.exh=true;SD.diving=false;try{msg('¡Sin aire! Sube a respirar.',1600)}catch(e){}}
  if(Math.random()<d*14){build();spawn(P.x+(Math.random()-.5)*.7,WY-1.1,P.z+(Math.random()-.5)*.7,0,1.3+Math.random(),0,.9,.5+Math.random()*.5,true)}
 }else{
  SD.air=Math.min(1,SD.air+d/CFG.airRecover);
  if(SD.exh&&SD.air>=CFG.minAirToDive)SD.exh=false;
 }
 SD.depth+=((SD.diving?1:0)-SD.depth)*(1-Math.exp(-(SD.diving?9:6)*d));
 // 2) velocidad lateral: más lento sumergido
 if(window.SWIM&&SD.baseV!=null){SWIM.vmax=SD.baseV*(1-(1-CFG.diveSpeed)*SD.depth);SWIM.stroke=SD.dash>0?SD.baseStroke*2.8:SD.baseStroke}
 // 3) durante la brazada se simula empuje en esa dirección (así el nado base mantiene el ritmo de brazadas)
 const sv={a:k.KeyA,d:k.KeyD};
 if(SD.dash>0){if(SD.dir>0)k.KeyD=true;else k.KeyA=true}
 else if(SD.fakeSwim&&!(k.KeyA||k.KeyD||k.ArrowLeft||k.ArrowRight||Math.abs(JS.x||0)>.12)){k.KeyD=true;if(window.SWIM)SWIM.vmax=.001}
 const x0=P.x,z0=P.z;let r;
 try{r=upd0.apply(this,arguments)}finally{k.KeyA=sv.a;k.KeyD=sv.d}
 // 4) pelea: el sumergido avanza más lento (el nado base ya lo hace en el tramo del río)
 if(BS.on&&SD.depth>.05){const f=1-(1-CFG.diveSpeed)*SD.depth;P.x=x0+(P.x-x0)*f;P.z=z0+(P.z-z0)*f;pl.position.x=P.x;pl.position.z=P.z}
 // 5) impulso de la brazada rápida (se suma después, así el tope de velocidad normal no lo recorta)
 if(SD.dash>0){
  const pr=1-SD.dash/CFG.dashTime,sp=CFG.dashSpeed*Math.pow(1-pr,1.5);
  const dx=SD.lx*sp*d,dz=SD.lz*sp*d;
  P.x+=dx;P.z+=dz;pl.position.x+=dx;pl.position.z+=dz;
  if(BS.on){const cx=roadX(-410);P.x=clamp(P.x,cx-30,cx+30);P.z=clamp(P.z,-426,-388);pl.position.x=P.x;pl.position.z=P.z}
  if(Math.random()<d*40){build();spawn(P.x,WY+.05,P.z,-SD.lx*2,2+Math.random()*2,-SD.lz*2,.45,.5+Math.random()*.6,false)}
  SD.dash=Math.max(0,SD.dash-d);
 }
 try{cam.position.y-=SD.depth*.55}catch(e){}
 return r;
};

// ---------- pose y efectos por fotograma ----------
const sa0=sceneAnim;
sceneAnim=function(t,dt){
 const r=sa0.apply(this,arguments);
 try{
  if(!R.active){if(SD.wasOn){SD.wasOn=false;resetState();relabel(false);if(fxEl)fxEl.style.display='none';if(airEl)airEl.style.display='none'}return r}
  SD.wasOn=true;
  const d=Math.min(.05,Math.max(0,Number(dt)||0));
  if(inRiver()){
   // brazada rápida: cuerpo lanzado hacia el lado, casi horizontal
   if(SD.dash>0){
    const pr=1-SD.dash/CFG.dashTime,env=Math.sin(Math.PI*clamp(pr,0,1));
    pl.rotation.y=-SD.dir*1.0*env;pl.rotation.z=-SD.dir*.35*env;
    try{const W=PA&&PA.mx&&PA.mx.getRoot();if(W)W.rotation.x=-(.45+.55*env)}catch(e){}
   }
   // buceo: el cuerpo se hunde de cabeza bajo el agua opaca
   if(SD.depth>.01){
    pl.position.y+=(CFG.diveY-pl.position.y)*SD.depth;
    pl.rotation.x=-1.2*SD.depth;
    if(SD.depth>.9&&!SD.hid){pl.visible=false;SD.hid=true}
    else if(SD.depth<=.9&&SD.hid){pl.visible=true;SD.hid=false}
   }else if(SD.hid){pl.visible=true;SD.hid=false}
   // pelea inundada: el agua llega a la cintura también en la arena
   if(inBoss()&&CFG.floodArena&&SD.depth<=.01){pl.position.y=-.34+Math.sin(t*4.3)*.03}
  }
  build();fxTick(t,d);uiTick();
 }catch(e){console.warn('v219 nado/buceo',e)}
 return r;
};
})();
</script>


