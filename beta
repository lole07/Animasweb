(function(){
  try {
    if (typeof GE!=='undefined' && typeof geBuild==='function') {
      const oldBuild=geBuild;
      geBuild=function(){
        oldBuild();
        for(const p of GE.patches){
          if(p.g.userData.schoolEarthPatch) continue;
          // Sustituye visualmente el arbusto por un parche de suelo y hierba alta.
          p.bush.visible=false; p.glow.visible=false; p.fg.forEach(s=>s.visible=false);
          const patch=new THREE.Group();
          const soilMat=new THREE.MeshLambertMaterial({color:0x493a25,roughness:1});
          const soilGeo=new THREE.CircleGeometry(1,18); soilGeo.rotateX(-Math.PI/2);
          const soil=new THREE.Mesh(soilGeo,soilMat); soil.scale.set(2.15,1,1.55); soil.position.y=.035; patch.add(soil);
          const bladeMat=new THREE.MeshLambertMaterial({color:0x42602b,side:THREE.DoubleSide});
          const bladeMat2=new THREE.MeshLambertMaterial({color:0x68783a,side:THREE.DoubleSide});
          for(let i=0;i<95;i++){
            const a=GER()*Math.PI*2, r=Math.sqrt(GER())*1.95;
            const h=.85+GER()*.85,w=.07+GER()*.07;
            const geo=new THREE.BufferGeometry();
