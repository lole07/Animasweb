const RUN=window.MOHAN_RUN={obs:[],nextZ:null,dist:0,pz:0,energy:1,exh:false,sprint:0,burst:0,cdB:0,slow:0,inv:0,lastGap:0,spPrev:false,shown:{},whirl:0,regen:0,done:false,tmsg:0,elapsed:0};
