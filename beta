(()=>{
 // Reacción breve de caída en primera persona al recibir la onda de la Patasola.
 // Se superpone a la cámara sin alterar movimiento, vida ni estados del juego.
 let fall=0,phase=0,baseRoll=0,lastZ=0,camWas=null;
 window.patasolaFall=function(){
   if(typeof S!=='undefined'&&S!=='play')return;
   fall=Math.max(fall,0.82);phase=0;
 };
 function tick(){
   try{
    if(typeof cam!=='undefined'&&cam&&fall>0){
      const dt=Math.min(.05,Math.max(.001,(performance.now()-lastZ)/1000||.016));lastZ=performance.now();
      phase+=dt;fall=Math.max(0,fall-dt);
      // Caída rápida hacia un costado y recuperación progresiva; no toca la orientación del jugador.
      const u=phase<.18?phase/.18:Math.max(0,fall/.64);
      const envelope=phase<.18?Math.sin(Math.PI*.5*Math.min(1,phase/.18)):Math.sin(Math.PI*.5*Math.min(1,fall/.64));
      const roll=(phase<.18?1:-1)*0.30*envelope;
      cam.rotation.z=roll;
      if(typeof shake!=='undefined')shake=Math.max(shake,phase<.18?.24:.04);
      if(fall<=0){cam.rotation.z=0;phase=0}
    } else if(typeof cam!=='undefined'&&cam){cam.rotation.z=0;lastZ=performance.now()}
   }catch(_){}
   requestAnimationFrame(tick);
 }
 requestAnimationFrame(tick);
})();
