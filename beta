  {n:FX.blobs,tex:blobTex,color:0x07110f,op:.62,add:false,vert:true,order:4,make:()=>{const side=rnd()<.5?-1:1;return{off:side*(15+rnd()*26),y:1.6+rnd()*4.2,h:2+rnd()*8,len:7+rnd()*20,sp:.75+rnd()*.7}}},
