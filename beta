// v246: decoracion procedural adicional por obstaculo; piezas visuales sin colision propia.
function detailObstacle(o,gx,gap,p){
 const g=o.g,cx=o.cx||roadX(o.z),rnd=()=>Math.random();
 const foamMat=new THREE.MeshStandardMaterial({color:0xb9d9ce,transparent:true,opacity:.34,roughness:.35,metalness:.02,depthWrite:false});
 const foamGeo=new THREE.SphereGeometry(1,7,5);
 const leafColors=[leafM,leafHi,leafWet,vineM];
 // Pequeñas crestas de espuma en torno a los objetos que sobresalen del agua.
 const foamN=2+Math.floor(rnd()*3);
 for(let i=0;i<foamN;i++){
  const f=new THREE.Mesh(foamGeo,foamMat);
  const side=rnd()<.5?-1:1;
  f.scale.set(.22+rnd()*.48,.035+rnd()*.035,.18+rnd()*.36);
  f.position.set(cx+gx+side*(gap*.35+rnd()*1.8),WY+.08+rnd()*.05,(rnd()-.5)*1.8);
  f.rotation.y=rnd()*Math.PI;g.add(f);
 }
 // Hojas mojadas y pequeñas ramas cambian de forma, escala y orientación en cada aparición.
 const leafN=2+Math.floor(rnd()*4);
 for(let i=0;i<leafN;i++){
  const side=rnd()<.5?-1:1, m=new THREE.Mesh(gLeaf,leafColors[Math.floor(rnd()*leafColors.length)]);
  const sc=.18+rnd()*.25;
  m.scale.set(sc,sc*(1.1+rnd()),sc*.75);
  m.position.set(cx+gx+side*(.5+rnd()*(gap*.6+1.6)),WY+.22+rnd()*.6,(rnd()-.5)*1.5);
  m.rotation.set((rnd()-.5)*.9,(rnd()-.5)*Math.PI,side*(.35+rnd()*.8));g.add(m);
 }
 if(o.type==='log'||o.type==='pillar'){
  // Nudos de corteza y ramitas rotas en posiciones variables.
  const n=2+Math.floor(rnd()*3);
  for(let i=0;i<n;i++){
   const x=cx+gx+(rnd()-.5)*(gap+4),len=.35+rnd()*.85;
   const twig=cyl(rnd()<.5?barkM:woodDark,.055+rnd()*.045,len,x,WY+.65+rnd()*.35,(rnd()-.5)*.5,(rnd()-.5)*1.25,(rnd()-.5)*.5);
   g.add(twig);
  }
 } else if(o.type==='rocks'){
  // Musgo irregular adherido a las piedras, con pequeñas vetas oscuras.
  const n=3+Math.floor(rnd()*4);
  for(let i=0;i<n;i++){
   const patch=new THREE.Mesh(gRock,rnd()<.55?leafHi:leafM);
   patch.scale.set(.18+rnd()*.38,.045+rnd()*.07,.16+rnd()*.3);
   patch.position.set(cx+gx+(rnd()-.5)*(gap+4),WY+.55+rnd()*1.25,(rnd()-.5)*1.25);
   patch.rotation.set(rnd(),rnd()*Math.PI,rnd());g.add(patch);
  }
 } else if(o.type==='branch'||o.type==='foliage'||o.type==='bush'){
  // Lianas colgantes y brotes laterales: se generan con variación por instancia.
  const n=2+Math.floor(rnd()*3);
  for(let i=0;i<n;i++){
   const side=rnd()<.5?-1:1,x=cx+gx+side*(gap*.5+1+rnd()*1.5),len=.55+rnd()*1.25;
   const vine=cyl(vineM,.035+rnd()*.035,len,x,WY+.45+rnd()*.6,(rnd()-.5)*.6,side*(.35+rnd()*.7),(rnd()-.5)*.35);
   g.add(vine);
  }
 }
}
function spawnOb(type,z,p){
 const gap=8.7-0.65*p;
 let gx=(Math.random()*2-1)*7.5;
 if(Math.abs(gx-RUN.lastGap)<5)gx=RUN.lastGap>0?-Math.abs(gx)-2:Math.abs(gx)+2;
 gx=clamp(gx,-8,8);RUN.lastGap=gx;
 let o;
 if(type==='log')o=mkLog(z,gx,gap);
 else if(type==='rocks')o=mkRocks(z,gx,gap);
 else if(type==='pillar')o=mkPillars(z,gx,gap);
 else if(type==='branch')o=mkBranch(z,gx,gap);
 else if(type==='foliage')o=mkFoliage(z,gx,gap);
 else o=mkBush(z,gx,gap,'bush');
 detailObstacle(o,gx,gap,p);
 scene.add(o.g);RUN.obs.push(o);return o;
}
function genAhead(){
 // Dar al jugador cuatro segundos al comenzar el nivel para orientarse; no se generan obstáculos durante este margen.
